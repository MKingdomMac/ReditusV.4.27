+    UParticleSystemComponent* SpawnEnemyAmpParticle(const FReditusATBAction& Action,
+        const TArray<UParticleSystem*>& Templates)
+    {
+        if (Action.ManagedEnemyAmpSpent <= 0 || Templates.Num() == 0 || !IsValid(Action.Unit)) return nullptr;
+        const UWorld* World = Action.Unit->GetWorld();
+        if (!World || !World->IsGameWorld() || World->bIsTearingDown || World->GetNetMode() == NM_DedicatedServer)
+            return nullptr;
+
+        UParticleSystem* Template = Templates[FMath::Min(Action.ManagedEnemyAmpSpent, Templates.Num()) - 1];
+        if (!IsValid(Template)) Template = Templates[0];
+        if (!IsValid(Template)) return nullptr;
+
+        const auto* Sprite = FindFProperty<FObjectPropertyBase>(Action.Unit->GetClass(), TEXT("Pixel2D"));
+        auto* Anchor = Sprite ? Cast<USceneComponent>(Sprite->GetObjectPropertyValue_InContainer(Action.Unit)) : nullptr;
+        if (!IsValid(Anchor)) Anchor = Action.Unit->GetRootComponent();
+        if (!IsValid(Anchor)) return nullptr;
+        return UGameplayStatics::SpawnEmitterAttached(Template, Anchor, NAME_None, FVector::ZeroVector,
+            FRotator::ZeroRotator, FVector(1.f), EAttachLocation::KeepRelativeOffset, true);
+    }
+
+    void ClearEnemyAmpParticle(FReditusATBAction& Action)
+    {
+        UParticleSystemComponent* Particle = Action.ManagedEnemyAmpParticle.Get();
+        Action.ManagedEnemyAmpParticle.Reset();
+        if (IsValid(Particle)) Particle->DestroyComponent();
+    }
