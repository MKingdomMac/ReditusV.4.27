+    void CaptureExperienceBeforeAward(const UObject* Controller, TMap<FName, int32>& Experience)
+    {
+        const auto* Roster = IsValid(Controller) ? FindFProperty<FMapProperty>(Controller->GetClass(), TEXT("PlayerUnitDataID")) : nullptr;
