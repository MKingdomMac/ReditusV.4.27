diff --git a/Plugins/ReditusTableBuffs/Source/ReditusTableBuffs/Private/ReditusTechMasteryLibrary.cpp b/Plugins/ReditusTableBuffs/Source/ReditusTableBuffs/Private/ReditusTechMasteryLibrary.cpp
