+                    Skills->SetFlags(RF_Transactional);
+                    Skills->Modify();
+                    bSaved = true;
+                }
+                Cost->SetPropertyValue_InContainer(Skill, 4);
+            }
+        }
+        if (bSaved) Skills->MarkPackageDirty();
+        return true;
