     FAutoConsoleCommand GInstallEnemyAI(TEXT("Reditus.InstallEnemyCombatAI"),
         TEXT("Attach the C++ enemy AI component and connect both skill selectors. Stop Play first."),
         FConsoleCommandDelegate::CreateStatic(&Install));
+
+    void InstallEnemyAmpDamage()
+    {
+        if (!GEditor || GEditor->PlayWorld)
+        {
+            UE_LOG(LogReditusEnemyAIInstall, Error, TEXT("Stop Play before running Reditus.InstallEnemyAmpDamage."));
+            return;
+        }
+        auto* Blueprint = LoadObject<UBlueprint>(nullptr,
+            TEXT("/Game/TurnBasedJRPGTemplate/Blueprints/Battle/BP_BattleController.BP_BattleController"));
+        auto* ATBClass = FindObject<UClass>(nullptr, TEXT("/Script/Chapter1Reditus.ReditusATBComponent"));
+        UFunction* Scale = ATBClass ? ATBClass->FindFunctionByName(TEXT("ScaleEnemyAmpDamage")) : nullptr;
+        auto* Graph = Blueprint ? FindFunctionGraph(Blueprint, TEXT("DealDamage")) : nullptr;
+        if (!Graph || !Scale)
+        {
+            UE_LOG(LogReditusEnemyAIInstall, Error, TEXT("The DealDamage graph or Scale Enemy Amp Damage node was unavailable."));
+            return;
+        }
+
+        UEdGraphPin* Damage = nullptr;
+        UEdGraphPin* Attacker = nullptr;
+        UEdGraphPin* AppliedDamage = nullptr;
+        UK2Node_CallFunction* Installed = nullptr;
+        for (UEdGraphNode* Node : Graph->Nodes)
+        {
+            if (auto* Get = Cast<UK2Node_VariableGet>(Node))
+                if (Get->VariableReference.GetMemberName() == TEXT("currentAttackingUnit") && !Attacker)
+                    Attacker = Pin(Get, TEXT("currentAttackingUnit"));
+
+            auto* Call = Cast<UK2Node_CallFunction>(Node);
+            auto* Exec = Pin(Call, UEdGraphSchema_K2::PN_Execute);
+            if (Exec && Exec->LinkedTo.Num() && IsCall(Call, TEXT("CalculateDamage")))
+            {
+                if (Damage)
+                {
+                    UE_LOG(LogReditusEnemyAIInstall, Error, TEXT("DealDamage has more than one live Calculate Damage call. Export the current graph."));
+                    return;
+                }
+                Damage = Pin(Call, TEXT("damage"));
+            }
+            if (Exec && Exec->LinkedTo.Num() && IsCall(Call, TEXT("TakeDamage")))
+                AppliedDamage = Pin(Call, TEXT("damage"));
+            if (Call && Call->GetTargetFunction() == Scale) Installed = Call;
+        }
+        auto* AttackerType = Attacker ? Cast<UClass>(Attacker->PinType.PinSubCategoryObject.Get()) : nullptr;
+        if (!Damage || Damage->Direction != EGPD_Output || Damage->PinType.PinCategory != UEdGraphSchema_K2::PC_Int ||
+            !AttackerType || !AttackerType->IsChildOf(AActor::StaticClass()) || !AppliedDamage)
+        {
+            UE_LOG(LogReditusEnemyAIInstall, Error, TEXT("DealDamage needs the shared Calculate Damage output, attacker and Take Damage input."));
+            return;
+        }
+        if (Installed)
+        {
+            if (TraceSource(Pin(Installed, TEXT("Damage"))) == Damage &&
+                TraceSource(AppliedDamage) == Pin(Installed, UEdGraphSchema_K2::PN_ReturnValue) &&
+                TraceSource(Pin(Installed, TEXT("Attacker"))) == Attacker &&
+                IsSelf(TraceSource(Pin(Installed, TEXT("BattleController")))))
+                UE_LOG(LogReditusEnemyAIInstall, Display, TEXT("Enemy AMP damage is already wired in BP_BattleController.DealDamage."));
+            else
+                UE_LOG(LogReditusEnemyAIInstall, Error, TEXT("Review the existing Scale Enemy Amp Damage node in BP_BattleController.DealDamage."));
+            return;
+        }
+        if (TraceSource(AppliedDamage) != Damage || !Damage->LinkedTo.Num())
+        {
+            UE_LOG(LogReditusEnemyAIInstall, Error, TEXT("Take Damage uses a different amount. Export BP_BattleController.DealDamage to review its wiring."));
+            return;
+        }
+
+        bool bSuccess = false;
+        {
+            const FScopedTransaction Transaction(NSLOCTEXT("ReditusEnemyAI", "InstallAmpDamage", "Wire Enemy AMP Damage"));
+            if (!Transaction.IsOutstanding()) return;
+            Blueprint->Modify();
+            Graph->Modify();
+            auto* Source = Damage->GetOwningNode();
+            Source->Modify();
+            Attacker->GetOwningNode()->Modify();
+            const TArray<UEdGraphPin*> Consumers = Damage->LinkedTo;
+            auto* Call = AddNode<UK2Node_CallFunction>(Graph, Source->NodePosX + 240, Source->NodePosY + 300);
+            Call->SetFromFunction(Scale);
+            Call->AllocateDefaultPins();
+            auto* Self = AddNode<UK2Node_Self>(Graph, Call->NodePosX - 160, Call->NodePosY + 100);
+            Self->AllocateDefaultPins();
+            bSuccess = Link(Pin(Self, UEdGraphSchema_K2::PN_Self), Pin(Call, TEXT("BattleController"))) &&
+                Link(Attacker, Pin(Call, TEXT("Attacker"))) && Link(Damage, Pin(Call, TEXT("Damage")));
+            for (auto* Consumer : Consumers)
+            {
+                if (!bSuccess) break;
+                Consumer->GetOwningNode()->Modify();
+                Damage->BreakLinkTo(Consumer);
+                bSuccess = Link(Pin(Call, UEdGraphSchema_K2::PN_ReturnValue), Consumer);
+            }
+            if (bSuccess)
+            {
+                FBlueprintEditorUtils::MarkBlueprintAsModified(Blueprint);
+                bSuccess = Compile(Blueprint);
+            }
+        }
+        if (!bSuccess)
+        {
+            const bool bUndone = GEditor->UndoTransaction(false);
+            if (bUndone) Compile(Blueprint);
+            UE_LOG(LogReditusEnemyAIInstall, Error, TEXT("Enemy AMP damage wiring could not compile. Blueprint undo %s."),
+                bUndone ? TEXT("succeeded") : TEXT("failed. Leave BP_BattleController unsaved"));
+            return;
+        }
+        UE_LOG(LogReditusEnemyAIInstall, Display, TEXT("Enemy AMP damage installed in DealDamage. Save BP_BattleController."));
+    }
+
+    FAutoConsoleCommand GInstallEnemyAmpDamage(TEXT("Reditus.InstallEnemyAmpDamage"),
+        TEXT("Wire spent enemy AMP into the shared damage result. Stop Play first."),
+        FConsoleCommandDelegate::CreateStatic(&InstallEnemyAmpDamage));
 }
