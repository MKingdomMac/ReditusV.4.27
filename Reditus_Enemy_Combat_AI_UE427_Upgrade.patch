+        Total->SetPropertyValue_InContainer(Action.Unit, ReditusAmpRules::Award(Total->GetPropertyValue_InContainer(Action.Unit),
+            Action.ManagedEnemyAmpSpent, Capacity->GetPropertyValue_InContainer(Action.Unit)));
