+        auto* VictoryInput = Pin(VictoryText, TEXT("InText"));
+        auto* VictoryItems = FindAnchor(Victory, TEXT("74ED7FF8461A7987A98258A5A37619AF"));
+        const TCHAR* MissingSite = nullptr;
+        if (!IsVariable(ResetGold, TEXT("totalGoldReward")) ||
